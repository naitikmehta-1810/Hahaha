{
  "name": "stuffsy-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/free-port.mjs && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node --loader ts-node/esm src/db/umzug.ts up",
    "migrate:down": "node --loader ts-node/esm src/db/umzug.ts down",
    "migrate:status": "node --loader ts-node/esm src/db/umzug.ts pending",
    "seed:categories": "tsx src/db/seeds/categories.seed.ts",
    "seed:demo": "tsx src/db/seeds/demo-catalog.seed.ts",
    "lint": "eslint . --max-warnings 100",
    "proof:race": "tsx scripts/concurrency-race-proof.mts",
    "proof:seller-scope": "tsx scripts/seller-scope-regression.mts",
    "proof:lifecycle": "tsx scripts/lifecycle-email-integration.mts",
    "proof:cod-invoice": "tsx scripts/cod-invoice-proof.mts",
    "proof:analytics": "tsx scripts/edit-analytics-proof.mts",
    "proof:contention": "tsx scripts/node-checkout-contention.mts",
    "ensure:payout-key": "tsx scripts/ensure-payout-key.mts"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.8",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  }
}
