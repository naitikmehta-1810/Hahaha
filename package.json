{
  "name": "stuffsy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"npm run dev:web\" \"npm run dev:backend\"",
    "dev:web": "next dev",
    "dev:backend": "npm run dev --prefix backend",
    "build": "next build",
    "build:backend": "npm run build --prefix backend",
    "start": "next start",
    "migrate": "npm run migrate --prefix backend",
    "lint": "eslint . --max-warnings 200"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5"
  }
}
